{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "color": "#5146D8", "name": "Primary" },
				{ "slug": "primary-hover", "color": "#4338B8", "name": "Primary Hover" },
				{ "slug": "dark", "color": "#111318", "name": "Dark" },
				{ "slug": "body", "color": "#555B66", "name": "Body" },
				{ "slug": "surface", "color": "#F6F7FB", "name": "Surface" },
				{ "slug": "border", "color": "#E6E8EE", "name": "Border" },
				{ "slug": "success", "color": "#16A34A", "name": "Success" },
				{ "slug": "sale", "color": "#EF4444", "name": "Sale" },
				{ "slug": "accent", "color": "#22C7E8", "name": "Accent" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "body", "size": "1rem", "name": "Body" },
				{ "slug": "h3", "size": "1.25rem", "name": "H3" },
				{ "slug": "h2", "size": "1.75rem", "name": "H2" },
				{ "slug": "h1", "size": "2.5rem", "name": "H1" },
				{ "slug": "display", "size": "3rem", "name": "Display" }
			]
		},
		"spacing": {
			"customMargin": true,
			"customPadding": true,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "1", "size": "4px", "name": "1" },
				{ "slug": "2", "size": "8px", "name": "2" },
				{ "slug": "3", "size": "12px", "name": "3" },
				{ "slug": "4", "size": "16px", "name": "4" },
				{ "slug": "5", "size": "20px", "name": "5" },
				{ "slug": "6", "size": "24px", "name": "6" },
				{ "slug": "8", "size": "32px", "name": "8" },
				{ "slug": "10", "size": "40px", "name": "10" },
				{ "slug": "12", "size": "48px", "name": "12" },
				{ "slug": "16", "size": "64px", "name": "16" },
				{ "slug": "20", "size": "80px", "name": "20" }
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		}
	}
}
